{
  "schema_version": 2,
  "effective": {
    "runtime": {
      "max_parallel_nodes": 4,
      "max_worker_processes": 4,
      "max_threads": 8,
      "max_cpu_percent": 100,
      "max_memory_mb": 2048,
      "max_inflight_bytes": 134217728,
      "queue_capacity": 1000,
      "shutdown_grace_seconds": 10
    },
    "execution": {
      "default_mode": "automatic",
      "default_profile": null,
      "stop_on_error": true,
      "allow_manual_mode": true,
      "max_call_depth": 16,
      "max_invocations_per_run": 1000,
      "node_timeout_seconds": 3600,
      "run_timeout_seconds": 86400,
      "retry_max_attempts": 1,
      "retry_backoff_ms": 1000,
      "retry_jitter": true
    },
    "templates": {
      "strict_undefined": true,
      "allow_dowai_if_alias": true,
      "max_nesting_depth": 32,
      "max_render_bytes": 1048576,
      "allowed_macros": []
    },
    "security": {
      "allow_external_writes": false,
      "require_approval_for_destructive": true,
      "allow_insecure_tls": false,
      "allowed_paths": [],
      "allowed_hosts": [],
      "allowed_profiles": []
    },
    "plugins": {
      "require_manifest": true,
      "allow_local_override": true,
      "max_parallel_calls": 4,
      "default_timeout_seconds": 300,
      "allow_network": false,
      "allow_filesystem": false,
      "allow_secrets": false,
      "max_output_bytes": 1048576,
      "require_idempotency_key": true
    },
    "logging": {
      "level": "INFO",
      "audit_enabled": true,
      "retention_days": 90,
      "rotation_max_mb": 64,
      "compression": "gzip",
      "redaction_enabled": true,
      "console_format": "text"
    },
    "lineage": {
      "enabled": false,
      "emit_mode": "disabled",
      "output_path": "lineage/openlineage.jsonl",
      "namespace": "dowai",
      "fail_on_emit_error": false
    },
    "ai": {
      "enabled": false,
      "default_profile": null,
      "max_tokens": 4096,
      "max_cost_per_run": 0.0,
      "timeout_seconds": 60,
      "allow_data_rows": false,
      "redaction": true,
      "profiles": {}
    },
    "sessions": {
      "conflict_policy": "error",
      "wait_process_timeout_seconds": 300,
      "ttl_seconds": 86400,
      "max_variables": 1000,
      "max_value_bytes": 65536,
      "max_context_bytes": 1048576,
      "allow_resume": true,
      "persist_state": true
    },
    "database": {
      "pool_max_connections": 4,
      "connect_timeout_seconds": 10,
      "query_timeout_seconds": 1800,
      "fetch_batch_rows": 10000,
      "write_batch_rows": 10000,
      "max_transfer_bytes": 1073741824,
      "tls_required": true
    },
    "python": {
      "dependency_lock_required": true,
      "install_tool": "uv",
      "venv_path": ".venv",
      "max_threads": 4,
      "resource_enforcement": "best_effort"
    },
    "state": {
      "backend": "sqlite",
      "path": "state/dowai.sqlite",
      "busy_timeout_ms": 5000,
      "checkpoint_policy": "after_commit",
      "retention_days": 90
    }
  },
  "origins": {
    "execution.default_mode": "engine_default",
    "ai.enabled": "engine_default"
  },
  "sources": {
    "engine_defaults": "active",
    "user": "not_loaded",
    "workspace": "not_loaded",
    "project": "loaded",
    "admin": "not_loaded"
  }
}
