{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowai.dev/schemas/plan.schema.json",
  "title": "DOWAI offline execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_mode", "nodes", "warnings"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "execution_mode": {
      "enum": ["automatic", "manual"]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "depends_on"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
